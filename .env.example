# Required before anyone can sign in. Use a long, unique password.
ADMIN_PASSWORD=replace-with-a-long-unique-password
# 32 random bytes encoded as base64. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=replace-with-32-random-bytes-base64
SESSION_SECRET=replace-with-a-long-random-secret

PORT=3000
NODE_ENV=development
DATA_DIR=./data
DEMO_MODE=true
# Leave blank until ICP filing succeeds. It will be shown in the website footer.
ICP_BEIAN_NUMBER=

# Fill these only after the Kuaishou e-commerce application has been approved.
# Keep all secrets in the host environment, never in GitHub.
KUAISHOU_APP_KEY=
KUAISHOU_APP_SECRET=
# This must exactly match the address entered in Kuaishou Open Platform.
KUAISHOU_REDIRECT_URI=https://zhenggaoxiang.cn/api/kuaishou/callback
KUAISHOU_OAUTH_AUTHORIZE_URL=
KUAISHOU_OAUTH_TOKEN_URL=
KUAISHOU_ORDER_LIST_URL=
KUAISHOU_SHIPMENT_SUBMIT_URL=

# The current e-commerce API documentation decides these values and request fields.
KUAISHOU_ORDER_LIST_HTTP_METHOD=POST
KUAISHOU_SHIPMENT_HTTP_METHOD=POST

